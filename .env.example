# Copy to .env (git-ignored) and adjust. Never commit real secrets.
# The same variables configure the app (commerce_agent.common.config) and deploy/compose.yml.

APP_ENV=dev
LOG_LEVEL=INFO
LOG_FORMAT=json

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=commerce
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=commerce

# Database timeouts in seconds (enforced by asyncpg). Defaults shown.
# DB_CONNECT_TIMEOUT_S=5
# DB_STATEMENT_TIMEOUT_S=30
# DB_BULK_TIMEOUT_S=600

REDIS_HOST=localhost
REDIS_PORT=6379

# Comma-separated allow-list; empty disables CORS.
CORS_ALLOW_ORIGINS=http://localhost:3000

# Needed from P3 onward (LLMClient). Set it in your shell or in .env, never in this file.
# ANTHROPIC_API_KEY=
